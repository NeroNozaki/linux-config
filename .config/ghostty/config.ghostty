# SHELL
command = /usr/bin/bash
shell-integration = bash
shell-integration-features = no-cursor


# SHORTCUTS
keybind = ctrl+==increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+shift+backspace=close_surface
keybind = ctrl+shift+h=goto_window:previous
keybind = ctrl+shift+l=goto_window:next

# THEME
theme = TokyoNight Moon

# FONT
font-family = RecMonoCasual Nerd Font
font-size = 11

# TRANSPARENCY
background-opacity = 0.8

# SOUNDS / NOTIFICATIONS
# desktop-notifications = false
# bell-features = no-audio

# CURSOR
cursor-style = block
mouse-hide-while-typing

# WINDOW
window-save-state = never
window-width = 840
window-height = 620
window-padding-x = 3
window-padding-y = 3
window-decoration = none
